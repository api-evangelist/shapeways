{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shapeways Cart API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.shapeways.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Cart",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get shipping options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shapeways.com/cart/shipping-options/v1",
            "params": [
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "Two-letter ISO 3166 country code."
              },
              {
                "name": "zipCode",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get shipping options"
        }
      ]
    }
  ],
  "bundled": true
}